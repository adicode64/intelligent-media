# ---- Application ----
ENVIRONMENT=development
DEBUG=true
# Browser origins allowed to call the API (used when DEBUG=false)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_JSON=true

# ---- Database ----
POSTGRES_USER=media
POSTGRES_PASSWORD=media
POSTGRES_DB=media
DATABASE_URL=postgresql+psycopg2://media:media@postgres:5432/media

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# ---- Storage / upload limits ----
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=10485760

# ---- Analysis thresholds (tune without code changes) ----
BLUR_FAIL_THRESHOLD=60
BLUR_WARN_THRESHOLD=120
BRIGHTNESS_DARK_THRESHOLD=55
BRIGHTNESS_WARN_DARK_THRESHOLD=80
BRIGHTNESS_WARN_BRIGHT_THRESHOLD=195
BRIGHTNESS_BRIGHT_THRESHOLD=220
DUPLICATE_EXACT_DISTANCE=2
DUPLICATE_SIMILAR_DISTANCE=8
DUPLICATE_SCAN_LIMIT=2000
MIN_IMAGE_WIDTH=320
MIN_IMAGE_HEIGHT=320
WARN_IMAGE_WIDTH=640
WARN_IMAGE_HEIGHT=480

# ---- OCR ----
OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.45
OCR_LANGUAGES=eng
OCR_TIMEOUT_SECONDS=20

# ---- Worker retries ----
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF_SECONDS=5
